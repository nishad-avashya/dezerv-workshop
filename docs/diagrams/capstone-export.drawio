<mxfile host="drawio" agent="dezerv-workshop">
  <diagram id="capstone-export" name="Capstone export and redeploy">
    <mxGraphModel dx="1200" dy="700" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1240" pageHeight="540" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="zip" value="exports/kyc-agent-skeleton.zip" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#232F3E;verticalAlign=top;fontStyle=1;fontSize=12;arcSize=3;" vertex="1" parent="1">
          <mxGeometry x="20" y="20" width="440" height="500" as="geometry" />
        </mxCell>
        <mxCell id="z0" value="&lt;b&gt;agent.yaml, charter.md&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;the manifest and charter: the source of truth&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#01A88D;fontSize=11;align=left;spacingLeft=8;fillColor=#E6F6F7;" vertex="1" parent="1">
          <mxGeometry x="40" y="60" width="400" height="40" as="geometry" />
        </mxCell>
        <mxCell id="z1" value="&lt;b&gt;profile.yaml, meta.json&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;generator input; anchor, marker, ticket key&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#232F3E;fontSize=11;align=left;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="40" y="110" width="400" height="40" as="geometry" />
        </mxCell>
        <mxCell id="z2" value="&lt;b&gt;data/&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;mongo/, cloudwatch/, changes/, incidents/, runbooks/, tickets.json&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#232F3E;fontSize=11;align=left;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="40" y="160" width="400" height="40" as="geometry" />
        </mxCell>
        <mxCell id="z3" value="&lt;b&gt;alerts/incident.json&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;the alert the demo sends&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#232F3E;fontSize=11;align=left;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="40" y="210" width="400" height="40" as="geometry" />
        </mxCell>
        <mxCell id="z4" value="&lt;b&gt;replay/*.json&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;3 generated cases + the ones you wrote&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#232F3E;fontSize=11;align=left;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="40" y="260" width="400" height="40" as="geometry" />
        </mxCell>
        <mxCell id="z5" value="&lt;b&gt;tools/get_kyc_request/&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;handler.py, tools.json (+ any make new-tool)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#ED7100;fontSize=11;align=left;spacingLeft=8;fillColor=#FDF1E7;" vertex="1" parent="1">
          <mxGeometry x="40" y="310" width="400" height="40" as="geometry" />
        </mxCell>
        <mxCell id="z6" value="&lt;b&gt;policy/*.cedar&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;rendered Cedar copied from agents/kyc-svc/policy/&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#FF9900;fontSize=11;align=left;spacingLeft=8;fillColor=#FFF4E5;" vertex="1" parent="1">
          <mxGeometry x="40" y="360" width="400" height="40" as="geometry" />
        </mxCell>
        <mxCell id="z7" value="&lt;b&gt;evals/report.json&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;the last make eval NAME=kyc-svc&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#232F3E;fontSize=11;align=left;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="40" y="410" width="400" height="40" as="geometry" />
        </mxCell>
        <mxCell id="z8" value="&lt;b&gt;DEMO.md, PATH-TO-PROD.md, README.md&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;filled in from capstone/templates/&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#232F3E;fontSize=11;align=left;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="40" y="460" width="400" height="40" as="geometry" />
        </mxCell>
        <mxCell id="warn" value="&lt;b&gt;Download it&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;the workshop account expires 72 h after it was booked; squads/, agents/ and exports/ are git-ignored, so git push does not save them&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FDECEE;strokeColor=#DD344C;dashed=1;fontSize=11;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="485" y="190" width="200" height="140" as="geometry" />
        </mxCell>
        <mxCell id="cloud" value="Dezerv&#x27;s own AWS account" style="points=[[0,0],[0.25,0],[0.5,0],[0.75,0],[1,0],[1,0.25],[1,0.5],[1,0.75],[1,1],[0.75,1],[0.5,1],[0.25,1],[0,1],[0,0.75],[0,0.5],[0,0.25]];outlineConnect=0;gradientColor=none;html=1;whiteSpace=wrap;fontSize=12;fontStyle=1;container=0;pointerEvents=0;collapsible=0;recursiveResize=0;shape=mxgraph.aws4.group;grIcon=mxgraph.aws4.group_aws_cloud_alt;strokeColor=#232F3E;fillColor=none;verticalAlign=top;align=left;spacingLeft=30;fontColor=#232F3E;dashed=0;" vertex="1" parent="1">
          <mxGeometry x="710" y="20" width="520" height="500" as="geometry" />
        </mxCell>
        <mxCell id="r0" value="&lt;b&gt;1  make bootstrap &amp;&amp; make solution-part6&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;Lab A&#x27;s stack, Gateway, policy, memory, Runtime in the target account&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#8C4FFF;fontSize=11;align=left;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="735" y="70" width="470" height="52" as="geometry" />
        </mxCell>
        <mxCell id="r1" value="&lt;b&gt;2  copy the folder to squads/kyc/&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;in a clone of the workshop repo&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#8C4FFF;fontSize=11;align=left;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="735" y="140" width="470" height="52" as="geometry" />
        </mxCell>
        <mxCell id="re1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#232F3E;fontSize=10;" edge="1" parent="1" source="r0" target="r1">
          <mxGeometry relative="1" as="geometry"></mxGeometry>
        </mxCell>
        <mxCell id="r2" value="&lt;b&gt;3  make provision-squad SQUAD=kyc&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;synthetic data to S3, log backfill, injection ticket&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#8C4FFF;fontSize=11;align=left;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="735" y="210" width="470" height="52" as="geometry" />
        </mxCell>
        <mxCell id="re2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#232F3E;fontSize=10;" edge="1" parent="1" source="r1" target="r2">
          <mxGeometry relative="1" as="geometry"></mxGeometry>
        </mxCell>
        <mxCell id="r3" value="&lt;b&gt;4  make new-agent NAME=kyc-svc FROM=squads/kyc/agent.yaml&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;then make deploy-agent NAME=kyc-svc&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#8C4FFF;fontSize=11;align=left;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="735" y="280" width="470" height="52" as="geometry" />
        </mxCell>
        <mxCell id="re3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#232F3E;fontSize=10;" edge="1" parent="1" source="r2" target="r3">
          <mxGeometry relative="1" as="geometry"></mxGeometry>
        </mxCell>
        <mxCell id="r4" value="&lt;b&gt;5  make eval NAME=kyc-svc &amp;&amp; make gate NAME=kyc-svc&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;the same gate, now in your account&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#8C4FFF;fontSize=11;align=left;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="735" y="350" width="470" height="52" as="geometry" />
        </mxCell>
        <mxCell id="re4" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#232F3E;fontSize=10;" edge="1" parent="1" source="r3" target="r4">
          <mxGeometry relative="1" as="geometry"></mxGeometry>
        </mxCell>
        <mxCell id="note" value="The factory regenerates Gateway targets, Cedar and memory from agent.yaml. Edit the manifest, not the generated files. Next: replace the mocks with real connectors (PATH-TO-PROD.md)." style="text;html=1;fontSize=10;fontColor=#5A6B86;align=left;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="735" y="430" width="470" height="70" as="geometry" />
        </mxCell>
        <mxCell id="ez" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#DD344C;fontSize=10;strokeWidth=2;exitX=1;exitY=0.52;entryX=0;entryY=0.5;" edge="1" parent="1" source="zip" target="warn">
          <mxGeometry relative="1" as="geometry"></mxGeometry>
        </mxCell>
        <mxCell id="ew" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#DD344C;fontSize=10;strokeWidth=2;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="warn" target="r0">
          <mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="700" y="260" /><mxPoint x="700" y="96" /></Array></mxGeometry>
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
