          <mxGeometry x="560" y="50" width="48" height="48" as="geometry" />
        </mxCell>

        <!-- Gateway group -->
        <mxCell id="gw" value="AgentCore Gateway (one MCP endpoint, 6 targets, 14 tools)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F2EEFB;strokeColor=#8C4FFF;verticalAlign=top;fontStyle=1;fontSize=12;arcSize=3;container=1;collapsible=0;" vertex="1" parent="cloud">
