          <mxGeometry x="20" y="154" width="320" height="44" as="geometry" />
        </mxCell>
        <mxCell id="s4" value="&lt;b&gt;4&lt;/b&gt;  Invoke the target Lambda" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#8C4FFF;fontSize=11;align=left;spacingLeft=8;" vertex="1" parent="gw">
          <mxGeometry x="20" y="213" width="320" height="40" as="geometry" />
        </mxCell>
        <mxCell id="s5" value="&lt;b&gt;5&lt;/b&gt;  RESPONSE interceptor&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;mask PII, wrap free text in &amp;lt;untrusted&amp;gt;&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#8C4FFF;fontSize=11;align=left;spacingLeft=8;" vertex="1" parent="gw">
          <mxGeometry x="20" y="268" width="320" height="44" as="geometry" />
        </mxCell>

