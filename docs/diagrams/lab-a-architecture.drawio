<mxfile host="drawio" agent="dezerv-workshop">
  <diagram id="lab-a-arch" name="Lab A architecture">
    <mxGraphModel dx="1200" dy="700" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1280" pageHeight="720" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- AWS Cloud / account boundary -->
        <mxCell id="cloud" value="Workshop account (us-west-2)" style="points=[[0,0],[0.25,0],[0.5,0],[0.75,0],[1,0],[1,0.25],[1,0.5],[1,0.75],[1,1],[0.75,1],[0.5,1],[0.25,1],[0,1],[0,0.75],[0,0.5],[0,0.25]];outlineConnect=0;gradientColor=none;html=1;whiteSpace=wrap;fontSize=12;fontStyle=1;container=1;pointerEvents=0;collapsible=0;recursiveResize=0;shape=mxgraph.aws4.group;grIcon=mxgraph.aws4.group_aws_cloud_alt;strokeColor=#232F3E;fillColor=none;verticalAlign=top;align=left;spacingLeft=30;fontColor=#232F3E;dashed=0;" vertex="1" parent="1">
          <mxGeometry x="20" y="20" width="1240" height="680" as="geometry" />
        </mxCell>

        <!-- Engineer -->
        <mxCell id="user" value="On-call engineer" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#232F3D;strokeColor=none;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=12;fontStyle=0;aspect=fixed;pointerEvents=1;shape=mxgraph.aws4.user;" vertex="1" parent="cloud">
          <mxGeometry x="40" y="90" width="48" height="48" as="geometry" />
        </mxCell>
        <mxCell id="alert" value="Alert&lt;br&gt;inc-sip-timeout.json" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#E7157B;strokeColor=none;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=12;fontStyle=0;aspect=fixed;pointerEvents=1;shape=mxgraph.aws4.alarm;" vertex="1" parent="cloud">
          <mxGeometry x="40" y="230" width="48" height="48" as="geometry" />
        </mxCell>

        <!-- Agent group -->
        <mxCell id="agentgrp" value="Agent: Strands + Claude Sonnet 4.6&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;local in Parts 1-5, AgentCore Runtime in Part 6&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E6F6F7;strokeColor=#01A88D;verticalAlign=top;fontStyle=1;fontSize=12;arcSize=4;container=1;collapsible=0;" vertex="1" parent="cloud">
          <mxGeometry x="160" y="60" width="250" height="330" as="geometry" />
        </mxCell>
        <mxCell id="runtime" value="AgentCore Runtime" style="sketch=0;points=[[0,0,0],[0.25,0,0],[0.5,0,0],[0.75,0,0],[1,0,0],[0,1,0],[0.25,1,0],[0.5,1,0],[0.75,1,0],[1,1,0],[0,0.25,0],[0,0.5,0],[0,0.75,0],[1,0.25,0],[1,0.5,0],[1,0.75,0]];outlineConnect=0;fontColor=#232F3E;fillColor=#01A88D;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=11;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.bedrock;" vertex="1" parent="agentgrp">
          <mxGeometry x="101" y="50" width="48" height="48" as="geometry" />
        </mxCell>
        <mxCell id="h1" value="AuditHooks&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;one record per lifecycle event&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#01A88D;fontSize=11;" vertex="1" parent="agentgrp">
          <mxGeometry x="25" y="130" width="200" height="44" as="geometry" />
        </mxCell>
        <mxCell id="h2" value="MemoryHook&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;retrieve before each model call&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#01A88D;fontSize=11;" vertex="1" parent="agentgrp">
          <mxGeometry x="25" y="190" width="200" height="44" as="geometry" />
        </mxCell>
        <mxCell id="h3" value="StepLimits&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;25 tool calls / token budget, then escalate&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#01A88D;fontSize=11;" vertex="1" parent="agentgrp">
          <mxGeometry x="25" y="250" width="200" height="44" as="geometry" />
        </mxCell>

