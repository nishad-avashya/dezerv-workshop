        </mxCell>
        <mxCell id="s2" value="&lt;b&gt;2&lt;/b&gt;  REQUEST interceptor&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;rate limit 30/min, change freeze, gateway audit&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#8C4FFF;fontSize=11;align=left;spacingLeft=8;" vertex="1" parent="gw">
