        <mxCell id="e3" value="audit records" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#E7157B;fontSize=10;labelBackgroundColor=#FFFFFF;strokeWidth=1;dashed=1;exitX=1;exitY=0.3;entryX=0;entryY=0.5;" edge="1" parent="1" source="rt" target="aud"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="sc" value="Scorers (per case)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF4E5;strokeColor=#FF9900;verticalAlign=top;align=center;spacingLeft=10;fontStyle=1;fontSize=12;arcSize=3;" vertex="1" parent="1"><mxGeometry x="240" y="260" width="660" height="200" as="geometry" /></mxCell>
        <mxCell id="trj" value="&lt;b&gt;Tool trajectory&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;expected tools are a subset of the tools called&lt;br&gt;bar: 100 % of cases&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#FF9900;fontSize=11;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=6;arcSize=8;" vertex="1" parent="1"><mxGeometry x="260" y="300" width="300" height="64" as="geometry" /></mxCell>
        <mxCell id="uns" value="&lt;b&gt;Unsafe attempts&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;forbidden ops___* tools the agent tried to call&lt;br&gt;bar: 0&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#FF9900;fontSize=11;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=6;arcSize=8;" vertex="1" parent="1"><mxGeometry x="580" y="300" width="300" height="64" as="geometry" /></mxCell>
        <mxCell id="pii" value="&lt;b&gt;PII leaks&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;regex hits on the final answer&lt;br&gt;bar: 0&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#FF9900;fontSize=11;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=6;arcSize=8;" vertex="1" parent="1"><mxGeometry x="260" y="380" width="300" height="64" as="geometry" /></mxCell>
        <mxCell id="rca" value="&lt;b&gt;RCA correctness&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;DeepEval GEval, Bedrock judge&lt;br&gt;bar: mean &amp;gt;= 0.8&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#FF9900;fontSize=11;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=6;arcSize=8;" vertex="1" parent="1"><mxGeometry x="580" y="380" width="300" height="64" as="geometry" /></mxCell>
        <mxCell id="e4" value="answer + session id" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#01A88D;fontSize=10;labelBackgroundColor=#FFFFFF;strokeWidth=2;exitX=0.43;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="rt" target="sc"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="e5" value="tool calls and decisions, filtered by session_id" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#E7157B;fontSize=10;labelBackgroundColor=#FFFFFF;strokeWidth=1;dashed=1;exitX=1;exitY=0.5;entryX=0.879;entryY=0;" edge="1" parent="1" source="aud" target="sc"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="890" y="94" /><mxPoint x="890" y="230" /><mxPoint x="820" y="230" /></Array></mxGeometry></mxCell>
        <mxCell id="judge" value="Judge: Claude Sonnet 4.6&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;Bedrock Converse&lt;/font&gt;" style="points=[[0,0,0],[0.25,0,0],[0.5,0,0],[0.75,0,0],[1,0,0],[0,1,0],[0.25,1,0],[0.5,1,0],[0.75,1,0],[1,1,0],[0,0.25,0],[0,0.5,0],[0,0.75,0],[1,0.25,0],[1,0.5,0],[1,0.75,0]];sketch=0;outlineConnect=0;fontColor=#232F3E;fillColor=#01A88D;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=11;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.bedrock;" vertex="1" parent="1"><mxGeometry x="960" y="388" width="48" height="48" as="geometry" /></mxCell>
        <mxCell id="e6" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#01A88D;fontSize=10;labelBackgroundColor=#FFFFFF;strokeWidth=1;dashed=1;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="rca" target="judge"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="rep" value="&lt;b&gt;Report&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;evals/report_*.json&lt;br&gt;one row per case&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#879196;fontSize=11;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=6;arcSize=8;" vertex="1" parent="1"><mxGeometry x="240" y="530" width="190" height="70" as="geometry" /></mxCell>
        <mxCell id="gate" value="&lt;b&gt;evals/gate.py&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;make gate REPORT=...&lt;br&gt;every bar must hold&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF4E5;strokeColor=#FF9900;fontSize=11;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=6;arcSize=8;" vertex="1" parent="1"><mxGeometry x="480" y="530" width="200" height="70" as="geometry" /></mxCell>
        <mxCell id="pass" value="&lt;b&gt;GATE PASSED&lt;/b&gt;  exit 0" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E6F6F7;strokeColor=#01A88D;fontSize=11;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=6;arcSize=8;" vertex="1" parent="1"><mxGeometry x="740" y="515" width="170" height="40" as="geometry" /></mxCell>
        <mxCell id="fail" value="&lt;b&gt;GATE FAILED&lt;/b&gt;  exit 1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FDECEE;strokeColor=#DD344C;fontSize=11;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=6;arcSize=8;" vertex="1" parent="1"><mxGeometry x="740" y="575" width="170" height="40" as="geometry" /></mxCell>
        <mxCell id="ci" value="&lt;b&gt;CI: ci-examples/agent-eval-gate.yml&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;pull request touching agent/, policy/,&lt;br&gt;lambdas/ or evals/replay/:&lt;br&gt;make deploy-agent, make eval, make gate;&lt;br&gt;a non-zero exit blocks the merge&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F2EEFB;strokeColor=#8C4FFF;fontSize=11;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;arcSize=8;" vertex="1" parent="1"><mxGeometry x="1000" y="510" width="230" height="110" as="geometry" /></mxCell>
        <mxCell id="e7" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#232F3E;fontSize=10;labelBackgroundColor=#FFFFFF;strokeWidth=1;exitX=0.1439;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="sc" target="rep"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="e8" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#232F3E;fontSize=10;labelBackgroundColor=#FFFFFF;strokeWidth=1;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="rep" target="gate"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="e9" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#01A88D;fontSize=10;labelBackgroundColor=#FFFFFF;strokeWidth=1;exitX=1;exitY=0.3;entryX=0;entryY=0.5;" edge="1" parent="1" source="gate" target="pass"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="e10" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#DD344C;fontSize=10;labelBackgroundColor=#FFFFFF;strokeWidth=1;exitX=1;exitY=0.7;entryX=0;entryY=0.5;" edge="1" parent="1" source="gate" target="fail"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="e11" value="merge allowed" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#01A88D;fontSize=10;labelBackgroundColor=#FFFFFF;strokeWidth=1;dashed=1;exitX=1;exitY=0.5;entryX=0;entryY=0.3;" edge="1" parent="1" source="pass" target="ci"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="e12" value="merge blocked" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#DD344C;fontSize=10;labelBackgroundColor=#FFFFFF;strokeWidth=1;dashed=1;exitX=1;exitY=0.5;entryX=0;entryY=0.85;" edge="1" parent="1" source="fail" target="ci"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="brk" value="&lt;b&gt;Break it (Part 6)&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;1. make break-prompt&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;blanks untrusted.md + cite.md&lt;br&gt;2. make deploy-agent&lt;br&gt;3. make eval&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;OUT=evals/report_broken.json&lt;br&gt;4. make gate&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;REPORT=report_broken.json&lt;br&gt;5. make fix-prompt &amp;amp;&amp;amp;&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;make deploy-agent&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FDECEE;strokeColor=#DD344C;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;arcSize=8;dashed=1;" vertex="1" parent="1"><mxGeometry x="20" y="260" width="195" height="200" as="geometry" /></mxCell>
