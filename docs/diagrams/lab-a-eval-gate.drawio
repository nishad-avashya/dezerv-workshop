<mxfile host="drawio" agent="dezerv-workshop">
  <diagram id="lab-a-eval-gate" name="Replay evals and the CI gate">
    <mxGraphModel dx="1200" dy="700" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1240" pageHeight="690" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="cases" value="&lt;b&gt;Replay cases&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;evals/replay/*.json (10)&lt;br&gt;alert, expected root cause,&lt;br&gt;expected and forbidden tools&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#879196;fontSize=11;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=6;arcSize=8;" vertex="1" parent="1"><mxGeometry x="20" y="70" width="190" height="90" as="geometry" /></mxCell>
        <mxCell id="run" value="&lt;b&gt;evals/run_eval.py&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;make eval OUT=...&lt;br&gt;sends each case with InvokeAgentRuntime&lt;br&gt;one at a time, about 12 min; --cases a,b&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#879196;fontSize=11;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=6;arcSize=8;" vertex="1" parent="1"><mxGeometry x="240" y="70" width="200" height="90" as="geometry" /></mxCell>
        <mxCell id="rt" value="AgentCore Runtime&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;dezerv_payments_oncall (the deployed agent)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E6F6F7;strokeColor=#01A88D;verticalAlign=top;align=center;spacingLeft=10;fontStyle=1;fontSize=12;arcSize=3;" vertex="1" parent="1"><mxGeometry x="480" y="40" width="230" height="150" as="geometry" /></mxCell>
        <mxCell id="rticon" value="" style="points=[[0,0,0],[0.25,0,0],[0.5,0,0],[0.75,0,0],[1,0,0],[0,1,0],[0.25,1,0],[0.5,1,0],[0.75,1,0],[1,1,0],[0,0.25,0],[0,0.5,0],[0,0.75,0],[1,0.25,0],[1,0.5,0],[1,0.75,0]];sketch=0;outlineConnect=0;fontColor=#232F3E;fillColor=#01A88D;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=11;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.bedrock;" vertex="1" parent="1"><mxGeometry x="571" y="110" width="48" height="48" as="geometry" /></mxCell>
        <mxCell id="aud" value="/dezerv/agent-audit" style="points=[[0,0,0],[0.25,0,0],[0.5,0,0],[0.75,0,0],[1,0,0],[0,1,0],[0.25,1,0],[0.5,1,0],[0.75,1,0],[1,1,0],[0,0.25,0],[0,0.5,0],[0,0.75,0],[1,0.25,0],[1,0.5,0],[1,0.75,0]];sketch=0;outlineConnect=0;fontColor=#232F3E;fillColor=#E7157B;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=11;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.cloudwatch_2;" vertex="1" parent="1"><mxGeometry x="820" y="70" width="48" height="48" as="geometry" /></mxCell>
        <mxCell id="gwn" value="Every tool call still goes through the Gateway: JWT, interceptors, Cedar." style="text;html=1;fontSize=10;fontColor=#5A6B86;align=left;verticalAlign=middle;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="900" y="60" width="200" height="60" as="geometry" /></mxCell>
        <mxCell id="e1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#232F3E;fontSize=10;labelBackgroundColor=#FFFFFF;strokeWidth=1;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="cases" target="run"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
