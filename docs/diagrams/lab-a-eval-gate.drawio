        <mxCell id="e14" value="the broken prompt fails on RCA and trajectory" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#DD344C;fontSize=10;labelBackgroundColor=#FFFFFF;strokeWidth=1;dashed=1;exitX=0.5;exitY=1;entryX=0.5;entryY=1;" edge="1" parent="1" source="fail" target="brk"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="825" y="655" /><mxPoint x="117" y="655" /></Array></mxGeometry></mxCell>
