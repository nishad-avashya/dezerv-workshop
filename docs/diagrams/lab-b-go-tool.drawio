<mxfile host="drawio" agent="dezerv-workshop">
  <diagram id="lab-b-go-tool" name="Go Lambda as a governed tool">
    <mxGraphModel dx="1200" dy="700" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1280" pageHeight="720" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="cloud" value="Workshop account (us-west-2)" style="points=[[0,0],[0.25,0],[0.5,0],[0.75,0],[1,0],[1,0.25],[1,0.5],[1,0.75],[1,1],[0.75,1],[0.5,1],[0.25,1],[0,1],[0,0.75],[0,0.5],[0,0.25]];outlineConnect=0;gradientColor=none;html=1;whiteSpace=wrap;fontSize=12;fontStyle=1;container=1;pointerEvents=0;collapsible=0;recursiveResize=0;shape=mxgraph.aws4.group;grIcon=mxgraph.aws4.group_aws_cloud_alt;strokeColor=#232F3E;fillColor=none;verticalAlign=top;align=left;spacingLeft=30;fontColor=#232F3E;dashed=0;" vertex="1" parent="1"><mxGeometry x="20" y="20" width="1240" height="680" as="geometry" /></mxCell>
        <mxCell id="cog" value="Amazon Cognito&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;oncall: has payments/mandates.read&lt;br&gt;support: does not&lt;/font&gt;" style="points=[[0,0,0],[0.25,0,0],[0.5,0,0],[0.75,0,0],[1,0,0],[0,1,0],[0.25,1,0],[0.5,1,0],[0.75,1,0],[1,1,0],[0,0.25,0],[0,0.5,0],[0,0.75,0],[1,0.25,0],[1,0.5,0],[1,0.75,0]];outlineConnect=0;fontColor=#232F3E;fillColor=#DD344C;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=11;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.cognito;" vertex="1" parent="cloud"><mxGeometry x="60" y="60" width="48" height="48" as="geometry" /></mxCell>
        <mxCell id="agent" value="Agent (Runtime fx_payments_gw)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E6F6F7;strokeColor=#01A88D;verticalAlign=top;fontStyle=1;fontSize=12;arcSize=3;container=1;collapsible=0;" vertex="1" parent="cloud"><mxGeometry x="40" y="200" width="200" height="210" as="geometry" /></mxCell>
        <mxCell id="rt" value="" style="points=[[0,0,0],[0.25,0,0],[0.5,0,0],[0.75,0,0],[1,0,0],[0,1,0],[0.25,1,0],[0.5,1,0],[0.75,1,0],[1,1,0],[0,0.25,0],[0,0.5,0],[0,0.75,0],[1,0.25,0],[1,0.5,0],[1,0.75,0]];outlineConnect=0;fontColor=#232F3E;fillColor=#01A88D;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=11;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.bedrock;" vertex="1" parent="agent"><mxGeometry x="76" y="40" width="48" height="48" as="geometry" /></mxCell>
        <mxCell id="q" value="&amp;quot;Is user U-1042's SIP failing because of their mandate or because of the PSP?&amp;quot;" style="text;html=1;fontSize=11;fontColor=#232F3E;align=center;verticalAlign=middle;whiteSpace=wrap;" vertex="1" parent="agent"><mxGeometry x="10" y="100" width="180" height="60" as="geometry" /></mxCell>
        <mxCell id="q2" value="also calls find_transactions (db)" style="text;html=1;fontSize=10;fontColor=#5A6B86;align=center;verticalAlign=middle;whiteSpace=wrap;" vertex="1" parent="agent"><mxGeometry x="10" y="160" width="180" height="30" as="geometry" /></mxCell>
        <mxCell id="gw" value="Gateway fx-payments-gw" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F2EEFB;strokeColor=#8C4FFF;verticalAlign=top;fontStyle=1;fontSize=12;arcSize=3;container=1;collapsible=0;" vertex="1" parent="cloud"><mxGeometry x="320" y="60" width="400" height="470" as="geometry" /></mxCell>
        <mxCell id="g1" value="&lt;b&gt;1&lt;/b&gt;  Validate JWT (Cognito)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#8C4FFF;fontSize=11;align=left;spacingLeft=8;" vertex="1" parent="gw"><mxGeometry x="18" y="40" width="364" height="36" as="geometry" /></mxCell>
        <mxCell id="g2" value="&lt;b&gt;2&lt;/b&gt;  tools/list&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;mandates___get_mandate_status listed; revoke_mandate hidden by policy&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#8C4FFF;fontSize=11;align=left;spacingLeft=8;" vertex="1" parent="gw"><mxGeometry x="18" y="88" width="364" height="44" as="geometry" /></mxCell>
        <mxCell id="g3" value="&lt;b&gt;3&lt;/b&gt;  REQUEST interceptor (Lab A Lambda)&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;rate limit, change freeze, gateway audit&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#8C4FFF;fontSize=11;align=left;spacingLeft=8;" vertex="1" parent="gw"><mxGeometry x="18" y="144" width="364" height="44" as="geometry" /></mxCell>
        <mxCell id="g4" value="&lt;b&gt;4&lt;/b&gt;  Cedar (ENFORCE), rendered from tools.json&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;10: permit get_mandate_status if scope has mandates.read&lt;br&gt;50: forbid it unless that scope is present&lt;br&gt;30: forbid mandates___revoke_mandate (mutating: true)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF4E5;strokeColor=#FF9900;fontSize=11;align=left;spacingLeft=8;" vertex="1" parent="gw"><mxGeometry x="18" y="200" width="364" height="72" as="geometry" /></mxCell>
        <mxCell id="g5" value="&lt;b&gt;5&lt;/b&gt;  Invoke the Lambda&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;client context bedrockAgentCoreToolName = mandates___get_mandate_status; arguments = event JSON&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#8C4FFF;fontSize=11;align=left;spacingLeft=8;" vertex="1" parent="gw"><mxGeometry x="18" y="284" width="364" height="50" as="geometry" /></mxCell>
        <mxCell id="g6" value="&lt;b&gt;6&lt;/b&gt;  RESPONSE interceptor&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;PII mask again, &amp;lt;untrusted&amp;gt; tags&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#8C4FFF;fontSize=11;align=left;spacingLeft=8;" vertex="1" parent="gw"><mxGeometry x="18" y="346" width="364" height="44" as="geometry" /></mxCell>
        <mxCell id="deny" value="&lt;b&gt;Denied&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;support persona, or any call to revoke_mandate&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FDECEE;strokeColor=#DD344C;fontSize=11;align=left;spacingLeft=8;dashed=1;" vertex="1" parent="gw"><mxGeometry x="18" y="408" width="364" height="44" as="geometry" /></mxCell>
        <mxCell id="lam" value="Go Lambda dezerv-laba-fx-payments-gw-mandates&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;tools/mandates-go: provided.al2023, arm64, handler bootstrap&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F6FC;strokeColor=#00ADD8;verticalAlign=top;fontStyle=1;fontSize=12;arcSize=3;container=1;collapsible=0;" vertex="1" parent="cloud"><mxGeometry x="770" y="60" width="300" height="380" as="geometry" /></mxCell>
        <mxCell id="l1" value="&lt;b&gt;dispatch&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;strip the &amp;lt;target&amp;gt;___ prefix, switch on the tool name&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#00ADD8;fontSize=11;align=left;spacingLeft=8;" vertex="1" parent="lam"><mxGeometry x="15" y="56" width="270" height="44" as="geometry" /></mxCell>
        <mxCell id="l2" value="&lt;b&gt;get_mandate_status(user_id)&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;read-only; find the user's mandate; mask VPA and account number in the tool (mask.go)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#00ADD8;fontSize=11;align=left;spacingLeft=8;" vertex="1" parent="lam"><mxGeometry x="15" y="114" width="270" height="58" as="geometry" /></mxCell>
        <mxCell id="l3" value="&lt;b&gt;revoke_mandate&lt;/b&gt; (decoy)&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;never changes anything; logs WOULD_EXECUTE if it ever runs&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FDECEE;strokeColor=#DD344C;fontSize=11;align=left;spacingLeft=8;dashed=1;" vertex="1" parent="lam"><mxGeometry x="15" y="186" width="270" height="50" as="geometry" /></mxCell>
        <mxCell id="l4" value="&lt;b&gt;anything else&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;UNKNOWN_TOOL error&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#00ADD8;fontSize=11;align=left;spacingLeft=8;" vertex="1" parent="lam"><mxGeometry x="15" y="250" width="270" height="40" as="geometry" /></mxCell>
        <mxCell id="l5" value="Built by make deploy-agent with go build (GOOS=linux GOARCH=arm64 CGO_ENABLED=0, no Docker); prebuilt/mandates-go-arm64.zip if Go is missing" style="text;html=1;fontSize=10;fontColor=#5A6B86;align=center;verticalAlign=middle;whiteSpace=wrap;" vertex="1" parent="lam"><mxGeometry x="10" y="300" width="280" height="64" as="geometry" /></mxCell>
        <mxCell id="s3" value="S3 data bucket&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;mongo/mandates.json&lt;/font&gt;" style="points=[[0,0,0],[0.25,0,0],[0.5,0,0],[0.75,0,0],[1,0,0],[0,1,0],[0.25,1,0],[0.5,1,0],[0.75,1,0],[1,1,0],[0,0.25,0],[0,0.5,0],[0,0.75,0],[1,0.25,0],[1,0.5,0],[1,0.75,0]];outlineConnect=0;fontColor=#232F3E;fillColor=#7AA116;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=11;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.s3;" vertex="1" parent="cloud"><mxGeometry x="1140" y="180" width="48" height="48" as="geometry" /></mxCell>
