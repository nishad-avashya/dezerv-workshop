<mxfile host="drawio" agent="dezerv-workshop">
  <diagram id="lab-b-factory-render" name="Factory: render and deploy">
    <mxGraphModel dx="1200" dy="700" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1280" pageHeight="720" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="hin" value="&lt;b&gt;Inputs (you edit)&lt;/b&gt;" style="text;html=1;fontSize=12;fontColor=#232F3E;align=center;verticalAlign=middle;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="30" y="40" width="210" height="24" as="geometry" /></mxCell>
        <mxCell id="i1" value="&lt;b&gt;labs/B/agent.yaml&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;product, autonomy, connectors, policy, memory, evals, budgets&lt;/font&gt;" style="shape=note;whiteSpace=wrap;html=1;size=12;fillColor=#FFFFFF;strokeColor=#232F3E;fontSize=11;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="30" y="80" width="210" height="62" as="geometry" /></mxCell>
        <mxCell id="i2" value="&lt;b&gt;labs/B/charter.md&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;5 required sections&lt;/font&gt;" style="shape=note;whiteSpace=wrap;html=1;size=12;fillColor=#FFFFFF;strokeColor=#232F3E;fontSize=11;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="30" y="170" width="210" height="50" as="geometry" /></mxCell>
        <mxCell id="i3" value="&lt;b&gt;tools/&amp;lt;name&amp;gt;/tools.json&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;custom tool schemas, scope, mutating&lt;/font&gt;" style="shape=note;whiteSpace=wrap;html=1;size=12;fillColor=#FFFFFF;strokeColor=#232F3E;fontSize=11;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="30" y="248" width="210" height="50" as="geometry" /></mxCell>
        <mxCell id="i4" value="&lt;b&gt;evals/replay/*.json&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;at least 3 replay cases&lt;/font&gt;" style="shape=note;whiteSpace=wrap;html=1;size=12;fillColor=#FFFFFF;strokeColor=#232F3E;fontSize=11;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="30" y="326" width="210" height="50" as="geometry" /></mxCell>
        <mxCell id="i5" value="&lt;b&gt;data/incidents, data/runbooks&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;memory seed (from bootstrap)&lt;/font&gt;" style="shape=note;whiteSpace=wrap;html=1;size=12;fillColor=#FFFFFF;strokeColor=#232F3E;fontSize=11;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="30" y="404" width="210" height="50" as="geometry" /></mxCell>
        <mxCell id="rend" value="make new-agent: factory/render.py" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#232F3E;verticalAlign=top;fontStyle=1;fontSize=12;arcSize=3;container=1;collapsible=0;" vertex="1" parent="1"><mxGeometry x="290" y="60" width="290" height="470" as="geometry" /></mxCell>
        <mxCell id="r1" value="&lt;b&gt;1  Validate&lt;/b&gt; against agent.schema.json&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;autonomy L0/L1 only, forbid_ops: true, no wildcard zones, known connectors, tickets PAY, max_rows &amp;lt;= 200&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#232F3E;fontSize=11;align=left;spacingLeft=8;" vertex="1" parent="rend"><mxGeometry x="15" y="40" width="260" height="70" as="geometry" /></mxCell>
        <mxCell id="r2" value="&lt;b&gt;2  Extra checks&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;charter sections, custom tools.json exists, zone targets and tools exist, &amp;gt;= 3 replay cases, memory dirs exist&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#232F3E;fontSize=11;align=left;spacingLeft=8;" vertex="1" parent="rend"><mxGeometry x="15" y="124" width="260" height="70" as="geometry" /></mxCell>
        <mxCell id="r3" value="&lt;b&gt;3  Render&lt;/b&gt; with Jinja (StrictUndefined)&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;templates/prompt/role.md.j2, templates/cedar/policies.j2&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#232F3E;fontSize=11;align=left;spacingLeft=8;" vertex="1" parent="rend"><mxGeometry x="15" y="208" width="260" height="60" as="geometry" /></mxCell>
        <mxCell id="r4" value="&lt;b&gt;4  Write&lt;/b&gt; agents/&amp;lt;product&amp;gt;/&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;old *.cedar files removed first, so a removed zone disappears&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#232F3E;fontSize=11;align=left;spacingLeft=8;" vertex="1" parent="rend"><mxGeometry x="15" y="282" width="260" height="56" as="geometry" /></mxCell>
        <mxCell id="rbad" value="&lt;b&gt;INVALID agent.yaml:&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;one line per problem; nothing is written; exit 1&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FDECEE;strokeColor=#DD344C;fontSize=11;align=left;spacingLeft=8;dashed=1;" vertex="1" parent="rend"><mxGeometry x="15" y="380" width="260" height="56" as="geometry" /></mxCell>
        <mxCell id="outg" value="agents/payments-gw/ (generated)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#232F3E;verticalAlign=top;fontStyle=1;fontSize=12;arcSize=3;container=1;collapsible=0;" vertex="1" parent="1"><mxGeometry x="630" y="60" width="300" height="470" as="geometry" /></mxCell>
        <mxCell id="o1" value="&lt;b&gt;prompt/role.md&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;charter sections + workflow; untrusted.md, cite.md copied&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#01A88D;fontSize=11;align=left;spacingLeft=8;" vertex="1" parent="outg"><mxGeometry x="14" y="40" width="272" height="48" as="geometry" /></mxCell>
        <mxCell id="o2" value="&lt;b&gt;gateway/targets.json&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;Lab A Lambdas per connector, ops, custom targets&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#8C4FFF;fontSize=11;align=left;spacingLeft=8;" vertex="1" parent="outg"><mxGeometry x="14" y="102" width="272" height="48" as="geometry" /></mxCell>
        <mxCell id="o3" value="&lt;b&gt;policy/*.cedar&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;10 permit reads, 20 ticket writes, 30 forbid mutations, 40 unbounded, 50 explicit deny, 60 zones&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF4E5;strokeColor=#FF9900;fontSize=11;align=left;spacingLeft=8;" vertex="1" parent="outg"><mxGeometry x="14" y="164" width="272" height="62" as="geometry" /></mxCell>
        <mxCell id="o4" value="&lt;b&gt;memory/memory.json&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;fx_payments_gw, /products/payments-gw/{incidents,runbooks}&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#01A88D;fontSize=11;align=left;spacingLeft=8;" vertex="1" parent="outg"><mxGeometry x="14" y="240" width="272" height="48" as="geometry" /></mxCell>
        <mxCell id="o5" value="&lt;b&gt;evals/gates.json&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;rca 0.8, trajectory 1.0, unsafe 0, PII 0, budgets&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#232F3E;fontSize=11;align=left;spacingLeft=8;" vertex="1" parent="outg"><mxGeometry x="14" y="302" width="272" height="48" as="geometry" /></mxCell>
        <mxCell id="o6" value="&lt;b&gt;agent.yaml, charter.md, .manifest.sha&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;copies + the sha deploy and verify check&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#232F3E;fontSize=11;align=left;spacingLeft=8;" vertex="1" parent="outg"><mxGeometry x="14" y="364" width="272" height="48" as="geometry" /></mxCell>
        <mxCell id="ohdr" value="header: generated from agent.yaml@&amp;lt;sha&amp;gt; - edit the manifest, not this file" style="text;html=1;fontSize=10;fontColor=#5A6B86;align=center;verticalAlign=middle;whiteSpace=wrap;" vertex="1" parent="outg"><mxGeometry x="10" y="420" width="280" height="36" as="geometry" /></mxCell>
        <mxCell id="dep" value="make deploy-agent NAME=payments-gw: factory/deploy.py" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#232F3E;verticalAlign=top;fontStyle=1;fontSize=12;arcSize=3;container=1;collapsible=0;" vertex="1" parent="1"><mxGeometry x="980" y="60" width="270" height="470" as="geometry" /></mxCell>
