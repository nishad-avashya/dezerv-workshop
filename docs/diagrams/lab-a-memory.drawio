<mxfile host="drawio" agent="dezerv-workshop">
  <diagram id="lab-a-memory" name="Memory: seed once, retrieve before every model call">
    <mxGraphModel dx="1200" dy="700" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1240" pageHeight="620" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="lane1" value="1  Seeding: make seed-memory (once)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8F9FA;strokeColor=#879196;verticalAlign=top;align=left;spacingLeft=10;fontStyle=1;fontSize=12;arcSize=3;" vertex="1" parent="1"><mxGeometry x="20" y="40" width="760" height="210" as="geometry" /></mxCell>
        <mxCell id="lane2" value="2  Retrieval: MemoryHook, before EACH model call" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E6F6F7;strokeColor=#01A88D;verticalAlign=top;align=left;spacingLeft=10;fontStyle=1;fontSize=12;arcSize=3;" vertex="1" parent="1"><mxGeometry x="20" y="280" width="760" height="320" as="geometry" /></mxCell>
        <mxCell id="files" value="&lt;b&gt;Markdown records&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;data/incidents/*.md (26)&lt;br&gt;data/runbooks/*.md (8)&lt;br&gt;synthetic, generated at bootstrap&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#879196;fontSize=11;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=6;arcSize=8;" vertex="1" parent="1"><mxGeometry x="40" y="100" width="210" height="100" as="geometry" /></mxCell>
        <mxCell id="seed" value="&lt;b&gt;scripts/seed_memory.py&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;one record per file, batches of 10;&lt;br&gt;skips a namespace that is already seeded&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#879196;fontSize=11;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=6;arcSize=8;" vertex="1" parent="1"><mxGeometry x="290" y="100" width="230" height="100" as="geometry" /></mxCell>
        <mxCell id="es1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#232F3E;fontSize=10;labelBackgroundColor=#FFFFFF;strokeWidth=1;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="files" target="seed"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="mem" value="AgentCore Memory: dezerv_payments_oncall" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E6F6F7;strokeColor=#01A88D;verticalAlign=top;align=center;spacingLeft=10;fontStyle=1;fontSize=12;arcSize=3;" vertex="1" parent="1"><mxGeometry x="820" y="40" width="400" height="560" as="geometry" /></mxCell>
        <mxCell id="memicon" value="" style="points=[[0,0,0],[0.25,0,0],[0.5,0,0],[0.75,0,0],[1,0,0],[0,1,0],[0.25,1,0],[0.5,1,0],[0.75,1,0],[1,1,0],[0,0.25,0],[0,0.5,0],[0,0.75,0],[1,0.25,0],[1,0.5,0],[1,0.75,0]];sketch=0;outlineConnect=0;fontColor=#232F3E;fillColor=#01A88D;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=11;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.bedrock;" vertex="1" parent="1"><mxGeometry x="996" y="75" width="48" height="48" as="geometry" /></mxCell>
        <mxCell id="sem" value="Semantic strategy payments_facts&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;namespace /products/payments-gw&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#01A88D;verticalAlign=top;align=center;spacingLeft=10;fontStyle=1;fontSize=12;arcSize=3;" vertex="1" parent="1"><mxGeometry x="840" y="130" width="360" height="250" as="geometry" /></mxCell>
        <mxCell id="inc" value="&lt;b&gt;/products/payments-gw/incidents&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;26 past incidents, e.g. INC-2026-031&lt;br&gt;(the only config-change PSP timeout)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#01A88D;fontSize=11;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=6;arcSize=8;" vertex="1" parent="1"><mxGeometry x="860" y="185" width="320" height="80" as="geometry" /></mxCell>
        <mxCell id="rb" value="&lt;b&gt;/products/payments-gw/runbooks&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;8 runbooks, e.g. RB-PSP-TIMEOUT&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#01A88D;fontSize=11;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=6;arcSize=8;" vertex="1" parent="1"><mxGeometry x="860" y="285" width="320" height="70" as="geometry" /></mxCell>
        <mxCell id="epi" value="&lt;b&gt;Episodic strategy oncall_episodes&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;/products/payments-gw/episodes/{sessionId}&lt;br&gt;created by make memory; Lab A&#x27;s hook reads only the semantic records&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#01A88D;fontSize=11;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=6;arcSize=8;dashed=1;" vertex="1" parent="1"><mxGeometry x="840" y="410" width="360" height="80" as="geometry" /></mxCell>
        <mxCell id="lim" value="One semantic strategy per memory, with one namespace: the strategy owns the parent, records live one level below." style="text;html=1;fontSize=10;fontColor=#5A6B86;align=center;verticalAlign=middle;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="840" y="505" width="360" height="60" as="geometry" /></mxCell>
        <mxCell id="es2" value="BatchCreateMemoryRecords into /incidents and /runbooks&lt;br&gt;listable in about 30 s, no LLM extraction wait" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#01A88D;fontSize=10;labelBackgroundColor=#FFFFFF;strokeWidth=2;exitX=1;exitY=0.5;entryX=0;entryY=0.08;" edge="1" parent="1" source="seed" target="sem"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="b1" value="&lt;b&gt;BeforeModelCallEvent&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;Strands hook fires&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#01A88D;fontSize=11;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=6;arcSize=8;" vertex="1" parent="1"><mxGeometry x="40" y="340" width="170" height="70" as="geometry" /></mxCell>
        <mxCell id="b2" value="&lt;b&gt;Build the query&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;first call: the task (the alert)&lt;br&gt;later: the recent evidence, the head of&lt;br&gt;the last 6 messages (up to 2000 chars)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#01A88D;fontSize=11;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=6;arcSize=8;" vertex="1" parent="1"><mxGeometry x="235" y="330" width="250" height="90" as="geometry" /></mxCell>
        <mxCell id="b3" value="&lt;b&gt;Merge and inject&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;keep the best 8 incidents + 3 runbooks&lt;br&gt;append to the system prompt:&lt;br&gt;&quot;cite the INC-/RB- ids you rely on&quot;&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#01A88D;fontSize=11;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=6;arcSize=8;" vertex="1" parent="1"><mxGeometry x="510" y="330" width="250" height="90" as="geometry" /></mxCell>
        <mxCell id="eb12" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#232F3E;fontSize=10;labelBackgroundColor=#FFFFFF;strokeWidth=1;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="b1" target="b2"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="eq" value="RetrieveMemoryRecords, topK 8, each namespace" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#01A88D;fontSize=10;labelBackgroundColor=#FFFFFF;strokeWidth=1;dashed=1;exitX=0.5;exitY=0;entryX=0;entryY=0.75;" edge="1" parent="1" source="b2" target="inc"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="360" y="312" /><mxPoint x="800" y="312" /><mxPoint x="800" y="245" /></Array></mxGeometry></mxCell>
        <mxCell id="er" value="scored records" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#01A88D;fontSize=10;labelBackgroundColor=#FFFFFF;strokeWidth=1;dashed=1;exitX=0;exitY=0.79;entryX=1;entryY=0.5;" edge="1" parent="1" source="rb" target="b3"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="810" y="340" /><mxPoint x="810" y="375" /></Array></mxGeometry></mxCell>
        <mxCell id="model" value="Claude Sonnet 4.6&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;reasons, calls tools, gets new evidence&lt;/font&gt;" style="points=[[0,0,0],[0.25,0,0],[0.5,0,0],[0.75,0,0],[1,0,0],[0,1,0],[0.25,1,0],[0.5,1,0],[0.75,1,0],[1,1,0],[0,0.25,0],[0,0.5,0],[0,0.75,0],[1,0.25,0],[1,0.5,0],[1,0.75,0]];sketch=0;outlineConnect=0;fontColor=#232F3E;fillColor=#01A88D;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=11;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.bedrock;" vertex="1" parent="1"><mxGeometry x="611" y="470" width="48" height="48" as="geometry" /></mxCell>
        <mxCell id="eb3m" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#232F3E;fontSize=10;labelBackgroundColor=#FFFFFF;strokeWidth=1;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="b3" target="model"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
