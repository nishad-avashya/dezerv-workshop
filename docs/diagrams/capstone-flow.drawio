        </mxCell>
        <mxCell id="l1" value="1. Discovery and data  ·  minutes 0-25" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FDF1E7;strokeColor=#ED7100;verticalAlign=top;align=left;spacingLeft=12;fontStyle=1;fontSize=12;arcSize=4;" vertex="1" parent="1">
          <mxGeometry x="30" y="50" width="1190" height="150" as="geometry" />
        </mxCell>
        <mxCell id="l1s0" value="&lt;b&gt;Discovery (10 min)&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;Claude Code asks the 7 questions; service sheet&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#ED7100;fontSize=11;" vertex="1" parent="1">
