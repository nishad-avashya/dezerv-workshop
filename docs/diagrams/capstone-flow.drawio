<mxfile host="drawio" agent="dezerv-workshop">
  <diagram id="capstone-flow" name="Capstone flow">
    <mxGraphModel dx="1200" dy="700" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1240" pageHeight="660" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" value="Capstone: 90 minutes = 65 min build + 25 min demos (running example SQUAD=kyc PROFILE=kyc-svc)" style="text;html=1;fontSize=13;fontStyle=1;fontColor=#232F3E;align=left;verticalAlign=middle;" vertex="1" parent="1">
