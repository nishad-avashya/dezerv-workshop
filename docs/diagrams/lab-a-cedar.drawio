<mxfile host="drawio" agent="dezerv-workshop">
  <diagram id="lab-a-cedar" name="Personas, scopes and Cedar">
    <mxGraphModel dx="1200" dy="700" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1240" pageHeight="640" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="cog" value="&lt;b&gt;Amazon Cognito&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;each persona is an app client and gets a&lt;br&gt;client-credentials JWT with its scopes&lt;/font&gt;" style="points=[[0,0,0],[0.25,0,0],[0.5,0,0],[0.75,0,0],[1,0,0],[0,1,0],[0.25,1,0],[0.5,1,0],[0.75,1,0],[1,1,0],[0,0.25,0],[0,0.5,0],[0,0.75,0],[1,0.25,0],[1,0.5,0],[1,0.75,0]];sketch=0;outlineConnect=0;fontColor=#232F3E;fillColor=#DD344C;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=11;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.cognito;labelPosition=right;verticalLabelPosition=middle;align=left;verticalAlign=middle;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="30" y="40" width="48" height="48" as="geometry" /></mxCell>
        <mxCell id="on" value="&lt;b&gt;oncall&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;payments/logs.read  payments/db.read&lt;br&gt;payments/warehouse.read  payments/changes.read&lt;br&gt;payments/tickets.read  payments/tickets.write&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E6F6F7;strokeColor=#01A88D;fontSize=11;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;arcSize=8;" vertex="1" parent="1"><mxGeometry x="20" y="120" width="320" height="90" as="geometry" /></mxCell>
        <mxCell id="sup" value="&lt;b&gt;support&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;payments/tickets.read  payments/tickets.write&lt;br&gt;nothing else&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F2EEFB;strokeColor=#8C4FFF;fontSize=11;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;arcSize=8;" vertex="1" parent="1"><mxGeometry x="20" y="230" width="320" height="70" as="geometry" /></mxCell>
        <mxCell id="tag" value="The token&#x27;s &lt;b&gt;scope&lt;/b&gt; claim becomes the principal tag &lt;b&gt;scope&lt;/b&gt; (principal type AgentCore::OAuthUser)." style="text;html=1;fontSize=10;fontColor=#5A6B86;align=center;verticalAlign=middle;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="20" y="305" width="320" height="40" as="geometry" /></mxCell>
        <mxCell id="dec" value="&lt;b&gt;How Cedar decides one tools/call&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;1. Nothing matches: &lt;b&gt;deny&lt;/b&gt; (default deny)&lt;br&gt;2. Any matching &lt;b&gt;forbid&lt;/b&gt;: deny, and the error names the policy&lt;br&gt;3. Otherwise a matching &lt;b&gt;permit&lt;/b&gt;: allow&lt;br&gt;4. tools/list hides tools the caller can never use&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;(oncall sees 11 of 14: the 3 ops tools are hidden)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF4E5;strokeColor=#FF9900;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;arcSize=8;" vertex="1" parent="1"><mxGeometry x="20" y="360" width="320" height="112" as="geometry" /></mxCell>
        <mxCell id="h0" value="&lt;b&gt;Tool (&amp;lt;target&amp;gt;___&amp;lt;tool&amp;gt;)&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E9EBED;strokeColor=#232F3E;fontSize=11;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=6;arcSize=8;" vertex="1" parent="1"><mxGeometry x="380" y="20" width="290" height="32" as="geometry" /></mxCell>
        <mxCell id="h1" value="&lt;b&gt;oncall&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E9EBED;strokeColor=#232F3E;fontSize=11;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=6;arcSize=8;" vertex="1" parent="1"><mxGeometry x="670" y="20" width="120" height="32" as="geometry" /></mxCell>
