<mxfile host="drawio" agent="dezerv-workshop">
  <diagram id="lab-b-go-forwarder" name="Go service calls the agent">
    <mxGraphModel dx="1200" dy="700" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1280" pageHeight="720" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="cloud" value="Workshop account (us-west-2)" style="points=[[0,0],[0.25,0],[0.5,0],[0.75,0],[1,0],[1,0.25],[1,0.5],[1,0.75],[1,1],[0.75,1],[0.5,1],[0.25,1],[0,1],[0,0.75],[0,0.5],[0,0.25]];outlineConnect=0;gradientColor=none;html=1;whiteSpace=wrap;fontSize=12;fontStyle=1;container=1;pointerEvents=0;collapsible=0;recursiveResize=0;shape=mxgraph.aws4.group;grIcon=mxgraph.aws4.group_aws_cloud_alt;strokeColor=#232F3E;fillColor=none;verticalAlign=top;align=left;spacingLeft=30;fontColor=#232F3E;dashed=0;" vertex="1" parent="1"><mxGeometry x="20" y="20" width="1240" height="680" as="geometry" /></mxCell>
        <mxCell id="alert" value="Alert webhook&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;curl from terminal 2&lt;/font&gt;" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#E7157B;strokeColor=none;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=11;fontStyle=0;aspect=fixed;pointerEvents=1;shape=mxgraph.aws4.alarm;" vertex="1" parent="cloud"><mxGeometry x="80" y="150" width="48" height="48" as="geometry" /></mxCell>
        <mxCell id="fwd" value="go/alert-forwarder (Go, aws-sdk-go-v2)&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;make run-forwarder NAME=payments-gw, port 8090 (PORT= to change)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F6FC;strokeColor=#00ADD8;verticalAlign=top;fontStyle=1;fontSize=12;arcSize=3;container=1;collapsible=0;" vertex="1" parent="cloud"><mxGeometry x="250" y="60" width="380" height="420" as="geometry" /></mxCell>
        <mxCell id="s1" value="&lt;b&gt;1&lt;/b&gt;  Decode the alert JSON&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;POST /alert, body capped at 1 MB; bad JSON gives 400&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#00ADD8;fontSize=11;align=left;spacingLeft=8;" vertex="1" parent="fwd"><mxGeometry x="18" y="56" width="344" height="44" as="geometry" /></mxCell>
        <mxCell id="s2" value="&lt;b&gt;2&lt;/b&gt;  Session id from the alert fingerprint&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;alert-&amp;lt;sha256(alert, service, window_start)[:32]&amp;gt;, 38 chars&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#00ADD8;fontSize=11;align=left;spacingLeft=8;" vertex="1" parent="fwd"><mxGeometry x="18" y="114" width="344" height="44" as="geometry" /></mxCell>
        <mxCell id="s3" value="&lt;b&gt;3&lt;/b&gt;  InvokeAgentRuntime&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;region parsed from the runtime ARN, not AWS_REGION; 10 min deadline (-timeout)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#00ADD8;fontSize=11;align=left;spacingLeft=8;" vertex="1" parent="fwd"><mxGeometry x="18" y="172" width="344" height="44" as="geometry" /></mxCell>
        <mxCell id="s4" value="&lt;b&gt;4&lt;/b&gt;  Read the whole response body&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;unwrap {&amp;quot;answer&amp;quot;: ...}, print the diagnosis to stdout&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#00ADD8;fontSize=11;align=left;spacingLeft=8;" vertex="1" parent="fwd"><mxGeometry x="18" y="230" width="344" height="44" as="geometry" /></mxCell>
        <mxCell id="s5" value="&lt;b&gt;5&lt;/b&gt;  Reply 202&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;diagnosis streamed to stdout (N bytes), session alert-...&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#00ADD8;fontSize=11;align=left;spacingLeft=8;" vertex="1" parent="fwd"><mxGeometry x="18" y="288" width="344" height="44" as="geometry" /></mxCell>
        <mxCell id="fail" value="&lt;b&gt;Fail-safe&lt;/b&gt;: invoke error&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;log ERROR, reply 502 &amp;quot;agent unavailable; escalated to human on-call&amp;quot;&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FDECEE;strokeColor=#DD344C;fontSize=11;align=left;spacingLeft=8;dashed=1;" vertex="1" parent="fwd"><mxGeometry x="18" y="352" width="344" height="50" as="geometry" /></mxCell>
        <mxCell id="agent" value="AgentCore Runtime fx_payments_gw" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E6F6F7;strokeColor=#01A88D;verticalAlign=top;fontStyle=1;fontSize=12;arcSize=3;container=1;collapsible=0;" vertex="1" parent="cloud"><mxGeometry x="690" y="60" width="240" height="250" as="geometry" /></mxCell>
        <mxCell id="rt" value="Strands agent&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;rendered payments-gw prompt&lt;/font&gt;" style="points=[[0,0,0],[0.25,0,0],[0.5,0,0],[0.75,0,0],[1,0,0],[0,1,0],[0.25,1,0],[0.5,1,0],[0.75,1,0],[1,1,0],[0,0.25,0],[0,0.5,0],[0,0.75,0],[1,0.25,0],[1,0.5,0],[1,0.75,0]];outlineConnect=0;fontColor=#232F3E;fillColor=#01A88D;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=11;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.bedrock;" vertex="1" parent="agent"><mxGeometry x="96" y="50" width="48" height="48" as="geometry" /></mxCell>
        <mxCell id="ses" value="&lt;b&gt;session&lt;/b&gt; = runtime session id&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;a repeat alert reuses the session&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#01A88D;fontSize=11;align=left;spacingLeft=8;" vertex="1" parent="agent"><mxGeometry x="15" y="150" width="210" height="44" as="geometry" /></mxCell>
        <mxCell id="gw" value="Gateway fx-payments-gw" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F2EEFB;strokeColor=#8C4FFF;verticalAlign=top;fontStyle=1;fontSize=12;arcSize=3;container=1;collapsible=0;" vertex="1" parent="cloud"><mxGeometry x="1000" y="60" width="220" height="250" as="geometry" /></mxCell>
        <mxCell id="gw1" value="JWT, interceptor" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#8C4FFF;fontSize=11;align=left;spacingLeft=8;" vertex="1" parent="gw"><mxGeometry x="15" y="40" width="190" height="36" as="geometry" /></mxCell>
        <mxCell id="gw2" value="Cedar (ENFORCE)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF4E5;strokeColor=#FF9900;fontSize=11;align=left;spacingLeft=8;" vertex="1" parent="gw"><mxGeometry x="15" y="88" width="190" height="36" as="geometry" /></mxCell>
        <mxCell id="gw3" value="Lab A tool Lambdas&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;logs, db, warehouse, changes, tickets&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#8C4FFF;fontSize=11;align=left;spacingLeft=8;" vertex="1" parent="gw"><mxGeometry x="15" y="136" width="190" height="44" as="geometry" /></mxCell>
        <mxCell id="human" value="Human on-call&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;in production: your paging system&lt;/font&gt;" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#232F3D;strokeColor=none;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=11;fontStyle=0;aspect=fixed;pointerEvents=1;shape=mxgraph.aws4.user;" vertex="1" parent="cloud"><mxGeometry x="416" y="570" width="48" height="48" as="geometry" /></mxCell>
        <mxCell id="cw" value="stderr: slog JSON&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;session_id, service, caller, commit&lt;/font&gt;" style="points=[[0,0,0],[0.25,0,0],[0.5,0,0],[0.75,0,0],[1,0,0],[0,1,0],[0.25,1,0],[0.5,1,0],[0.75,1,0],[1,1,0],[0,0.25,0],[0,0.5,0],[0,0.75,0],[1,0.25,0],[1,0.5,0],[1,0.75,0]];outlineConnect=0;fontColor=#232F3E;fillColor=#E7157B;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=11;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.cloudwatch_2;" vertex="1" parent="cloud"><mxGeometry x="200" y="570" width="48" height="48" as="geometry" /></mxCell>
        <mxCell id="stdout" value="&lt;b&gt;Terminal 1&lt;/b&gt; (stdout)&lt;br&gt;the diagnosis appears here after 1-2 minutes" style="text;html=1;fontSize=11;fontColor=#232F3E;align=center;verticalAlign=middle;whiteSpace=wrap;" vertex="1" parent="cloud"><mxGeometry x="700" y="360" width="250" height="50" as="geometry" /></mxCell>
        <mxCell id="note" value="Production mapping: alarm or PagerDuty webhook, then event intake (this handler), then InvokeAgentRuntime, then ticket + page. Not covered: caller auth, retries, de-duplication across replicas." style="text;html=1;fontSize=10;fontColor=#5A6B86;align=left;verticalAlign=middle;whiteSpace=wrap;" vertex="1" parent="cloud"><mxGeometry x="700" y="470" width="500" height="60" as="geometry" /></mxCell>
        <mxCell id="e1" value="POST /alert" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#232F3E;fontSize=10;strokeWidth=2;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;entryX=0;entryY=0.271;" edge="1" parent="cloud" source="alert" target="fwd"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="e2" value="InvokeAgentRuntime" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#00ADD8;fontSize=10;strokeWidth=2;startArrow=block;labelBackgroundColor=#FFFFFF;" edge="1" parent="cloud" source="s3" target="rt"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="670" y="254" /><mxPoint x="670" y="134" /></Array></mxGeometry></mxCell>
        <mxCell id="e3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#8C4FFF;fontSize=10;strokeWidth=2;startArrow=block;labelBackgroundColor=#FFFFFF;" edge="1" parent="cloud" source="agent" target="gw"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="mcpl" value="MCP + JWT" style="text;html=1;fontSize=10;fontColor=#5A6B86;align=center;verticalAlign=middle;whiteSpace=wrap;" vertex="1" parent="cloud"><mxGeometry x="930" y="160" width="70" height="20" as="geometry" /></mxCell>
        <mxCell id="e4" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#00ADD8;fontSize=10;dashed=1;labelBackgroundColor=#FFFFFF;" edge="1" parent="cloud" source="s4" target="stdout"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="680" y="312" /><mxPoint x="680" y="385" /></Array></mxGeometry></mxCell>
        <mxCell id="e5" value="page" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#DD344C;fontSize=10;dashed=1;labelBackgroundColor=#FFFFFF;" edge="1" parent="cloud" source="fail" target="human"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="e6" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#E7157B;fontSize=10;dashed=1;labelBackgroundColor=#FFFFFF;" edge="1" parent="cloud" source="fwd" target="cw"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="224" y="270" /></Array></mxGeometry></mxCell>
      </root>
    </mxGraphModel>
