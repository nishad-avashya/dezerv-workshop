<mxfile host="drawio" agent="dezerv-workshop">
  <diagram id="lab-a-tool-call" name="Life of one tool call">
    <mxGraphModel dx="1200" dy="700" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1240" pageHeight="600" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="gw" value="AgentCore Gateway: dezerv-laba-gw" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F2EEFB;strokeColor=#8C4FFF;verticalAlign=top;align=left;spacingLeft=10;fontStyle=1;fontSize=12;arcSize=3;" vertex="1" parent="1"><mxGeometry x="210" y="40" width="1010" height="330" as="geometry" /></mxCell>
        <mxCell id="agent" value="&lt;b&gt;Agent&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;Strands + MCP client&lt;br&gt;tools/call with a Bearer JWT&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E6F6F7;strokeColor=#01A88D;fontSize=11;align=center;verticalAlign=bottom;spacingLeft=8;spacingRight=6;arcSize=8;" vertex="1" parent="1"><mxGeometry x="10" y="190" width="160" height="130" as="geometry" /></mxCell>
        <mxCell id="agicon" value="" style="points=[[0,0,0],[0.25,0,0],[0.5,0,0],[0.75,0,0],[1,0,0],[0,1,0],[0.25,1,0],[0.5,1,0],[0.75,1,0],[1,1,0],[0,0.25,0],[0,0.5,0],[0,0.75,0],[1,0.25,0],[1,0.5,0],[1,0.75,0]];sketch=0;outlineConnect=0;fontColor=#232F3E;fillColor=#01A88D;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=11;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.bedrock;" vertex="1" parent="1"><mxGeometry x="66" y="200" width="48" height="48" as="geometry" /></mxCell>
        <mxCell id="s1" value="&lt;b&gt;1&lt;/b&gt;  Validate JWT&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;Cognito discovery URL;&lt;br&gt;allowed clients oncall, support&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#8C4FFF;fontSize=11;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=6;arcSize=8;" vertex="1" parent="1"><mxGeometry x="225" y="210" width="180" height="80" as="geometry" /></mxCell>
        <mxCell id="s2" value="&lt;b&gt;2&lt;/b&gt;  REQUEST interceptor&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;rate limit 30/min per principal;&lt;br&gt;change freeze for write tools&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#8C4FFF;fontSize=11;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=6;arcSize=8;" vertex="1" parent="1"><mxGeometry x="425" y="210" width="180" height="80" as="geometry" /></mxCell>
        <mxCell id="s3" value="&lt;b&gt;3&lt;/b&gt;  Cedar policy (ENFORCE)&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;default deny;&lt;br&gt;forbid beats permit&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF4E5;strokeColor=#FF9900;fontSize=11;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=6;arcSize=8;" vertex="1" parent="1"><mxGeometry x="625" y="210" width="180" height="80" as="geometry" /></mxCell>
        <mxCell id="s4" value="&lt;b&gt;4&lt;/b&gt;  Target Lambda&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;logs, db, warehouse,&lt;br&gt;changes, tickets, ops (decoy)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FDF1E7;strokeColor=#ED7100;fontSize=11;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=6;arcSize=8;" vertex="1" parent="1"><mxGeometry x="825" y="210" width="180" height="80" as="geometry" /></mxCell>
        <mxCell id="s5" value="&lt;b&gt;5&lt;/b&gt;  RESPONSE interceptor&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;mask PII in every string;&lt;br&gt;wrap ticket/log text in &amp;lt;untrusted&amp;gt;&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#8C4FFF;fontSize=11;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=6;arcSize=8;" vertex="1" parent="1"><mxGeometry x="1025" y="210" width="180" height="80" as="geometry" /></mxCell>
        <mxCell id="d1" value="&lt;b&gt;Rejected&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;no valid token from an&lt;br&gt;allowed client: no tool runs&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FDECEE;strokeColor=#DD344C;fontSize=11;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=6;arcSize=8;dashed=1;" vertex="1" parent="1"><mxGeometry x="225" y="80" width="180" height="80" as="geometry" /></mxCell>
        <mxCell id="d2" value="&lt;b&gt;RATE_LIMITED&lt;/b&gt; or &lt;b&gt;CHANGE_FREEZE&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;tool result with isError: true;&lt;br&gt;Cedar and the Lambda never run&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FDECEE;strokeColor=#DD344C;fontSize=11;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=6;arcSize=8;dashed=1;" vertex="1" parent="1"><mxGeometry x="425" y="80" width="180" height="80" as="geometry" /></mxCell>
        <mxCell id="d3" value="&lt;b&gt;JSON-RPC error -32002&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;Tool Execution Denied ...&lt;br&gt;denied due to&lt;br&gt;P30_forbid_mutations_1&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FDECEE;strokeColor=#DD344C;fontSize=11;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=6;arcSize=8;dashed=1;" vertex="1" parent="1"><mxGeometry x="625" y="80" width="180" height="80" as="geometry" /></mxCell>
        <mxCell id="d4" value="Only permitted calls get here. If an &lt;b&gt;ops&lt;/b&gt; tool ever ran, the decoy would log &lt;b&gt;WOULD_EXECUTE&lt;/b&gt;." style="text;html=1;fontSize=10;fontColor=#5A6B86;align=center;verticalAlign=middle;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="825" y="80" width="180" height="80" as="geometry" /></mxCell>
